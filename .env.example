# Copy to .env and generate random unique secrets. Never commit actual secrets.
BOT_TOKEN=
WEBHOOK_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BINDING_PEPPER=
INTERNAL_API_KEY=
# Optional; bot must be started by owner or invited to the operator group.
SUPPORT_ALERT_CHAT_ID=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://replyforge:change-me@db:5432/replyforge
BUSINESS_CONFIG=config/business.yaml
WEBHOOK_PUBLIC_URL=https://support.example.com
WORKER_POLL_SECONDS=1
# Wait briefly for consecutive customer messages; 0 disables bundling.
MESSAGE_DEBOUNCE_MS=1200
# Redact old conversation content, media references and drafts; set 0 to disable.
DATA_RETENTION_DAYS=180
WORKER_LEASE_SECONDS=120
MAX_LLM_CALLS_PER_CHAT_PER_DAY=40
# Start in monitor-only mode; enable responses after testing through the admin UI.
AUTO_REPLY_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Media analysis is opt-in because customer screenshots and audio can contain private data.
AI_VISION_ENABLED=false
AI_VOICE_ENABLED=false
AI_MEDIA_MAX_BYTES=5242880
AI_VISION_MODEL=gpt-4.1-mini
AI_TRANSCRIPTION_MODEL=whisper-1
MARZBAN_BASE_URL=
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
PASARGUARD_BASE_URL=
PASARGUARD_API_KEY=
ALLOW_HTTP_PANELS=false

# Optional exact-version gate on read-only account lookups. Empty disables probe.
# PasarGuard gate additionally requires system.read; ordinary lookup needs users.read.
MARZBAN_EXPECTED_VERSION=
PASARGUARD_EXPECTED_VERSION=
